# PostgreSQL connection string (Neon or Supabase). Use the pooled URL on Vercel.
DATABASE_URL="postgresql://user:password@host:5432/hanlar_pure?sslmode=require"

# Admin dashboard
ADMIN_PASSWORD="change-me-to-a-long-password"
# Random string, at least 32 characters. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# International format, no "+" or spaces, e.g. 923001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Image uploads (Cloudinary). If empty, uploads are saved to /public/uploads in development only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Contact form email (https://resend.com). If empty, messages are only stored in the database.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
# Optional: verified sender, e.g. "HANLAR PURE <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=""
